#===========================================================
ufs_ne <- c("AL", "BA", "CE", "MA", "PB", "PE", "PI", "RN", "SE")
# Função auxiliar para transformar qualquer nome de estado do NE em Sigla limpa
uf_para_sigla <- function(coluna) {
case_match(
coluna,
c("Alagoas", "AL") ~ "AL",
c("Bahia", "BA") ~ "BA",
c("Ceará", "CE") ~ "CE",
c("Maranhão", "MA") ~ "MA",
c("Paraíba", "PB") ~ "PB",
c("Pernambuco", "PE") ~ "PE",
c("Piauí", "PI") ~ "PI",
c("Rio Grande do Norte", "RN") ~ "RN",
c("Sergipe", "SE") ~ "SE",
.default = NA_character_
)
}
#===========================================================
# 1. BASE ANEEL (SIGA)
#===========================================================
siga <- read.csv2(
"siga-empreendimentos-geracao.csv",
fileEncoding = "Latin1",
stringsAsFactors = FALSE
)
# Identifica automaticamente a coluna que contém "EntradaOperacao"
coluna_data <- names(siga)[str_detect(names(siga), regex("EntradaOperacao", ignore_case = TRUE))][1]
energia <- siga %>%
filter(SigUFPrincipal %in% ufs_ne) %>%
mutate(
UF = SigUFPrincipal,
Data = dmy(.data[[coluna_data]]),
Ano = year(Data)
) %>%
filter(Ano >= 2010 & Ano <= 2024) %>%
group_by(UF, Ano) %>%
summarise(
Potencia_MW = sum(as.numeric(MdaPotenciaFiscalizadaKw), na.rm = TRUE) / 1000,
.groups = "drop"
)
#===========================================================
# 2. BASE IDHM (data.xlsx)
#===========================================================
idhm_raw <- read_excel("data.xlsx")
idhm <- idhm_raw %>%
select(
Territorialidades,
matches("^IDHM [0-9]{4}$")
) %>%
pivot_longer(
cols = -Territorialidades,
names_to = "Ano",
values_to = "IDHM"
) %>%
mutate(
Ano = as.integer(gsub("IDHM ", "", Ano)),
Estado_limpo = trimws(Territorialidades),
UF = uf_para_sigla(Estado_limpo)
) %>%
filter(!is.na(UF), Ano >= 2010, Ano <= 2024) %>%
select(UF, Ano, IDHM)
#===========================================================
# 3. BASE POPULAÇÃO (POP2025_20260113.xls)
#===========================================================
pop_raw <- read_excel("POP2025_20260113.xls")
populacao <- pop_raw %>%
rename(Estado_bruto = 1, Populacao = 2) %>%
mutate(
Estado_limpo = trimws(Estado_bruto),
UF = uf_para_sigla(Estado_limpo)
) %>%
filter(!is.na(UF)) %>%
select(UF, Populacao)
#===========================================================
# 4. BASE PIB (pib-per-capita-r.csv)
#===========================================================
pib_raw <- read.csv("pib-per-capita-r.csv", fileEncoding = "UTF-8")
