rename(Estado_bruto = 1, PIB_per_capita = 2) %>%
mutate(
Estado_limpo = trimws(Estado_bruto),
UF = uf_para_sigla(Estado_limpo),
PIB_per_capita = as.numeric(PIB_per_capita)
) %>%
filter(!is.na(UF)) %>%
select(UF, PIB_per_capita)
#===========================================================
# 5. JUNÇÃO FINAL COMPLETA (Usando UF como Chave)
#===========================================================
dados_finais <- energia %>%
# Junta com IDHM combinando perfeitamente a UF e o Ano
left_join(idhm, by = c("UF", "Ano")) %>%
# Junta com População e PIB usando apenas a UF
left_join(populacao, by = "UF") %>%
left_join(pib_final, by = "UF")
